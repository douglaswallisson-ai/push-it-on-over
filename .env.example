# Base da API. Vazio = mesma origem.
# Em desenvolvimento aponte para o backend local ou para o túnel.
# ATENÇÃO: tudo com prefixo VITE_ é embutido no bundle do navegador.
# Nunca coloque segredo de servidor aqui — apenas URLs públicas.
VITE_API_BASE=

# Serviço de posições em tempo real (ss-nexus-websocket-api).
# Sem esta variável o mapa usa consulta periódica em vez de WebSocket.
# Ex.: wss://nexus.sstelematica.com.br
VITE_WS_BASE=

# API de checklist (API Gateway, backend separado do ss-fleet-core).
# Sem esta variavel a tela de checklist mostra apenas a explicacao.
# Ex.: https://c7fdrfqx0f.execute-api.us-east-1.amazonaws.com/Development
VITE_CHECKLIST_BASE=
